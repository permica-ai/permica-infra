# Swagger OpenAPI 2.0 Spec for GCP API Gateway
swagger: '2.0'
info:
  title: "${api_name}"
  description: "API Gateway proxy for ${api_name} (${environment})"
  version: "1.0.0"
host: "${gateway_host}"
schemes:
  - https
produces:
  - application/json

# Path Routing
paths:
  # Public Swagger UI & Documentation Endpoints (No Auth Required)
  /docs:
    get:
      summary: Swagger UI Page
      operationId: get_swagger_ui
      x-google-backend:
        address: "${cloud_run_url}/docs"
      responses:
        '200':
          description: OK

  /openapi.json:
    get:
      summary: Raw OpenAPI Spec
      operationId: get_openapi_json
      x-google-backend:
        address: "${cloud_run_url}/openapi.json"
      responses:
        '200':
          description: OK

  # Root Healthcheck Endpoint
  /:
    get:
      summary: Root Healthcheck
      operationId: get_root
      x-google-backend:
        address: "${cloud_run_url}/"
      responses:
        '200':
          description: OK

  # Specific Health Check Endpoint (e.g. /health)
  /health:
    get:
      summary: Healthcheck
      operationId: get_health
      x-google-backend:
        address: "${cloud_run_url}/health"
      responses:
        '200':
          description: OK

  # Single segment /api/{path} (e.g. /api/health)
  /api/{path}:
    get:
      summary: Proxy Single-Segment GET
      operationId: proxy_get_api_single
      parameters:
        - name: path
          in: path
          required: true
          type: string
      x-google-backend:
        address: "${cloud_run_url}/api/{path}"
      security:
        - api_key: []
      responses:
        '200':
          description: OK
    post:
      summary: Proxy Single-Segment POST
      operationId: proxy_post_api_single
      parameters:
        - name: path
          in: path
          required: true
          type: string
      x-google-backend:
        address: "${cloud_run_url}/api/{path}"
      security:
        - api_key: []
      responses:
        '200':
          description: OK

  # Multi-level nested API routes (e.g. /api/v1/monitor/status, /api/v1/signals)
  /api/{p1}/{p2}:
    get:
      summary: Proxy 2-Segment GET
      operationId: proxy_get_api_2
      parameters:
        - name: p1
          in: path
          required: true
          type: string
        - name: p2
          in: path
          required: true
          type: string
      x-google-backend:
        address: "${cloud_run_url}/api/{p1}/{p2}"
      security:
        - api_key: []
      responses:
        '200':
          description: OK
    post:
      summary: Proxy 2-Segment POST
      operationId: proxy_post_api_2
      parameters:
        - name: p1
          in: path
          required: true
          type: string
        - name: p2
          in: path
          required: true
          type: string
      x-google-backend:
        address: "${cloud_run_url}/api/{p1}/{p2}"
      security:
        - api_key: []
      responses:
        '200':
          description: OK

  /api/{p1}/{p2}/{p3}:
    get:
      summary: Proxy 3-Segment GET
      operationId: proxy_get_api_3
      parameters:
        - name: p1
          in: path
          required: true
          type: string
        - name: p2
          in: path
          required: true
          type: string
        - name: p3
          in: path
          required: true
          type: string
      x-google-backend:
        address: "${cloud_run_url}/api/{p1}/{p2}/{p3}"
      security:
        - api_key: []
      responses:
        '200':
          description: OK
    post:
      summary: Proxy 3-Segment POST
      operationId: proxy_post_api_3
      parameters:
        - name: p1
          in: path
          required: true
          type: string
        - name: p2
          in: path
          required: true
          type: string
        - name: p3
          in: path
          required: true
          type: string
      x-google-backend:
        address: "${cloud_run_url}/api/{p1}/{p2}/{p3}"
      security:
        - api_key: []
      responses:
        '200':
          description: OK

  /api/{p1}/{p2}/{p3}/{p4}:
    get:
      summary: Proxy 4-Segment GET
      operationId: proxy_get_api_4
      parameters:
        - name: p1
          in: path
          required: true
          type: string
        - name: p2
          in: path
          required: true
          type: string
        - name: p3
          in: path
          required: true
          type: string
        - name: p4
          in: path
          required: true
          type: string
      x-google-backend:
        address: "${cloud_run_url}/api/{p1}/{p2}/{p3}/{p4}"
      security:
        - api_key: []
      responses:
        '200':
          description: OK

securityDefinitions:
  api_key:
    type: apiKey
    name: key
    in: query
